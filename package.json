{
  "name": "bubble-film-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:solver && npm run build && node --test tests/rendered-html.test.mjs",
    "test:solver": "node --no-warnings --experimental-loader ./tests/typescript-loader.mjs --test tests/solver.test.ts",
    "analyze:solver": "node --no-warnings --experimental-loader ./tests/typescript-loader.mjs scripts/analyze-solver.ts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "wrangler": "4.151.3",
    "miniflare": "5.20261019.1-beta"
  },
  "type": "module",
  "overrides": {
    "@vercel/og": {
      "fflate": "0.8.3"
    }
  }
}
